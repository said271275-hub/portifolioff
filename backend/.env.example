# Django asosiy sozlamalari
SECRET_KEY=django-insecure-football-portfolio-super-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Ma'lumotlar bazasi (Lokalda bo'sh qoldirilsa SQLite ishlatiladi, Neon/Prod uchun PostgreSQL URL)
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# CORS Sozlamalari (Frontend domeningiz)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# GitHub Integratsiyasi (Proxy orqali repolarni tortish uchun)
# Shaxsiy GitHub profilingiz foydalanuvchi nomi
GITHUB_USERNAME=your_github_username
# GitHub Personal Access Token (ixtiyoriy, ammo API limitiga uchramaslik uchun tavsiya etiladi - rate limit 5000/hr)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# Telegram Bot Xabarnoma (Aloqa formasidan xabar kelganda sizga yuborish uchun)
# @BotFather orqali olingan token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# @userinfobot orqali olingan shaxsiy chat/user id
TELEGRAM_CHAT_ID=123456789

# Cloudinary (Ixtiyoriy - production rasm saqlash uchun)
CLOUDINARY_URL=

